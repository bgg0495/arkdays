 "statusRules": {
  "note": "§10.2. 위에서부터 첫 일치. z 는 cap 숨은 값, uL 은 혈중 결정 밀도. 협정(agreement)은 항상 contractor + RHO_CONTRACTOR.",
  "rules": [
   { "if": { "via": "agreement" }, "status": "contractor", "dept": "field", "track": "RHO_CONTRACTOR" },
   { "if": { "infected": true, "via": "treatment", "money": "<3" }, "status": "patient", "dept": "logistics", "track": "RHO_PATIENT", "laborFor": "RHO_LOGISTICS" },
   { "if": { "infected": true, "via": "treatment" }, "status": "patient", "dept": "medical", "track": "RHO_PATIENT" },
   {
    "if": { "cap": { "skill": ">=0.5" }, "infectedStage": "<=1" },
    "status": "operator",
    "dept": "field",
    "track": "RHO_OPERATOR"
   },
   {
    "if": { "cap": { "learn": ">=0.5" }, "prevArchetypes": ["A9"], "prevJobs": ["doctor","nurse"] },
    "status": "operator",
    "dept": "medical",
    "track": "RHO_MEDICAL"
   },
   {
    "if": { "cap": { "learn": ">=0.5" } },
    "status": "operator",
    "dept": "engineer",
    "track": "RHO_ENGINEER"
   },
   { "if": { "prevArchetypes": ["A10","A3"] }, "status": "operator", "deptAny": ["hr","purchase"], "track": "RHO_HR" },
   { "if": {  }, "status": "operator", "dept": "logistics", "track": "RHO_LOGISTICS" }
  ],
  "patientToOperator": { "afterYears": 2, "pYear": 0.25, "requires": { "infectedStage": "<=2" } },
  "contractorToOperator": { "decision": "rhodes_convert", "afterYears": 3 }
 },
